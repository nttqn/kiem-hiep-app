rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player reads and writes only their own save slots.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public leaderboard: anyone reads; a signed-in player writes only the
    // rows of their own five slots (three before 1.11.0), with sane values.
    match /leaderboard/{id} {
      // Săn quái week and Lôi đài season now, by server time in Vietnam
      // (UTC+7), counted from 2026-10-26 as the app does, an hour of slack
      // for clocks a little fast. A phone set days ahead must not file its
      // score under a week or season still to come.
      function vnMs() {
        return request.time.toMillis() + 25200000 + 3600000 - 1792972800000;
      }

      // A row's values ([d] = request.resource.data, [wk] = this week, [sn]
      // = this season). 1.13.0: written against short names, the week and
      // season worked out once: spelled out as request.resource.data.x and
      // weekNow() at every use, a top hero's full row plus the new look and
      // st ran past Firestore's 1,000-expression limit per request and was
      // denied, while small heroes went through.
      function goodRow(d, wk, sn) {
        return d.name is string && d.name.size() > 0 && d.name.size() <= 24
          && d.title is string && d.title.size() <= 40
          && d.hanh is int && d.hanh >= 0 && d.hanh <= 4
          && d.level is int && d.level >= 1 && d.level <= 99
          && d.rebirths is int && d.rebirths >= 0 && d.rebirths <= 6
          && d.rank == d.rebirths * 100 + d.level
          && d.power is int && d.power >= 0 && d.power <= 50000000
          // No hero has more lực chiến than this for their level and rebirths.
          && d.power <= 20000 * (d.rank + 10)
          && d.tower is int && d.tower >= 0 && d.tower <= 5000
          // Lôi đài season * 100000 + points (1.0.10+; older apps omit it),
          // and the last finished season's score, for its rank reward (1.2.5+).
          && (!('arenaS' in d)
              || (d.arenaS is int && d.arenaS >= 0 && d.arenaS < (sn + 1) * 100000))
          && (!('arenaLast' in d)
              || (d.arenaLast is int && d.arenaLast >= 0 && d.arenaLast < (sn + 1) * 100000))
          // Săn quái tuần (1.2.6+): week * 1000000 + kills (up to 999,999 a
          // week since 1.8.3, was 300,000); and the last finished week's, for
          // its rank reward.
          && (!('wk' in d) || (d.wk is int && d.wk >= 0 && d.wk < (wk + 1) * 1000000))
          && (!('wkLast' in d) || (d.wkLast is int && d.wkLast >= 0 && d.wkLast < (wk + 1) * 1000000))
          // The mount ridden (1.4.0+), shown on Lôi đài copies, and its look (1.7.0+).
          && (!('mount' in d) || (d.mount is string && d.mount.size() <= 20))
          && (!('skin' in d) || (d.skin is string && d.skin.size() <= 24))
          && (!('mountLv' in d) || (d.mountLv is int && d.mountLv >= 1 && d.mountLv <= 200))
          // Võ Lâm Đại Hội titles (1.4.0+): at most one a week.
          && (!('dhC' in d) || (d.dhC is int && d.dhC >= 0 && d.dhC <= wk))
          // 1.8.0: Tâm Ma best floor; Ma Vực week * 1000 + floor; Hung Thú
          // week * 10000 + difficulty (1-3) * 1000 + speed. None from a week
          // still to come.
          // 1.13.3: no shadow past 8x the row's lực chiến (tamMaPlausible).
          && (!('tm' in d) || (d.tm is int && d.tm >= 0 && d.tm <= 1000
              && (d.tm <= 1 || 400000 * math.pow(1.05, d.tm - 1) <= d.power * 8)))
          && (!('mv' in d) || (d.mv is int && d.mv >= 0 && d.mv < (wk + 1) * 1000))
          && (!('ht' in d)
              || (d.ht is int && d.ht >= 0 && d.ht % 10000 < 4000 && d.ht < (wk + 1) * 10000))
          // Play seconds (1.2.2+; older apps omit it): at least 2 hours per
          // rebirth and a minute per level. The fastest real hero seen (a
          // non-stop auto-fight farmer) took about 4.5 hours per rebirth.
          && (!('play' in d) || (d.play is int && d.play >= d.rebirths * 7200 + d.level * 60))
          // Potential points (1.2.4+): no more than the game hands out, as in
          // HeroData.maxPotential (5 a level, 40 a rebirth, 90 from pills, 100
          // slack, and 5 more a level in the sixth life, 1.6.0+).
          && (!('pts' in d)
              || (d.pts is int
                  && d.pts <= (d.level - 1) * 5 + d.rebirths * 40 + 190
                      + (d.rebirths >= 6 ? d.level * 5 : 0)))
          // Ngộ Đạo tầng (1.12.0+): only in the sixth life at level 99, and
          // at least ten minutes of play a tầng past that.
          && (!('dao' in d)
              || (d.dao is int && d.dao >= 0 && d.dao <= 999
                  && (d.dao == 0 || d.rank == 699)
                  && (!('play' in d) || d.play >= 49140 + d.dao * 600)))
          // The Cấp độ board's value (1.12.0+): rank * 1000 + Ngộ Đạo tầng.
          && (!('rk' in d) || d.rk == d.rank * 1000 + ('dao' in d ? d.dao : 0))
          // Looks, worn gear and stats for "Xem thông tin" (1.12.0+), by size.
          && (!('look' in d) || (d.look is map && d.look.size() <= 7))
          && (!('st' in d) || (d.st is list && d.st.size() <= 10));
      }

      allow read: if true;
      allow create, update: if request.auth != null
        && id in [request.auth.uid + '_0', request.auth.uid + '_1', request.auth.uid + '_2', request.auth.uid + '_3', request.auth.uid + '_4']
        && request.resource.data.uid == request.auth.uid
        && goodRow(request.resource.data,
            math.floor(vnMs() / 604800000) + 1,
            math.floor(vnMs() / 1209600000) + 1)
        // Muted by hand in the console: lbBans/{uid} (any fields).
        && !exists(/databases/$(database)/documents/lbBans/$(request.auth.uid));
      // A row that is not there is fine to delete (1.13.0: hiding deleted
      // every slot and day, and each missing one counted as a rules error).
      allow delete: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
    }

    // Banned accounts, written by hand in the console. The app reads the
    // list (1.9.1) to leave their rows off the boards; uids are public in
    // the leaderboard row ids anyway.
    match /lbBans/{id} {
      allow read: if true;
    }

    // Cheating reports from the leaderboard, read in the console.
    match /lbReports/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.row is string
        && id == request.resource.data.row + '_' + request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.keys().hasOnly(['row', 'uid', 'name', 'at']);
    }

    // Hòm thư: gifts written by hand in the console, read by every player.
    match /mail/{id} {
      allow read: if true;
    }

    // Cập nhật (1.4.0+): config/app.min, the oldest version still allowed
    // to play, written by hand in the console.
    match /config/{id} {
      allow read: if true;
    }

    // Sự kiện: boosts switched on by hand in the console (1.2.3+).
    match /events/{id} {
      allow read: if true;
    }

    // Boss Thế Giới: one board per Vietnam day, same ownership rules.
    // Boss Hoàng Kim (1.12.0): as Boss Thế Giới, twice its daily cap
    // (goldBossDayCap), and only written today during a session (12:00 and
    // 21:00 Vietnam time, 30 minutes each) or the ten minutes after it.
    match /goldboss/{day}/hits/{id} {
      function vnNow() {
        return request.time + duration.value(7, 'h');
      }
      function vnToday() {
        let t = vnNow();
        return t.year() * 10000 + t.month() * 100 + t.day();
      }
      function inSession() {
        let m = vnNow().hours() * 60 + vnNow().minutes();
        return (m >= 720 && m < 760) || (m >= 1260 && m < 1300);
      }

      allow read: if true;
      allow create, update: if request.auth != null
        && day.matches('[0-9]{8}')
        && int(day) == vnToday()
        && inSession()
        && id in [request.auth.uid + '_0', request.auth.uid + '_1', request.auth.uid + '_2', request.auth.uid + '_3', request.auth.uid + '_4']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.hanh is int
        && request.resource.data.hanh >= 0 && request.resource.data.hanh <= 4
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 99
        && request.resource.data.rebirths is int
        && request.resource.data.rebirths >= 0 && request.resource.data.rebirths <= 6
        && request.resource.data.dmg is int
        && request.resource.data.dmg >= 0
        && request.resource.data.dmg <= 4000000000 * (request.resource.data.rebirths + 1)
        && (request.resource.data.rebirths > 0
            || request.resource.data.dmg <= 4122 * request.resource.data.level
                * request.resource.data.level * request.resource.data.level)
        && !exists(/databases/$(database)/documents/lbBans/$(request.auth.uid));
      // A row that is not there is fine to delete (1.13.0: hiding deleted
      // every slot and day, and each missing one counted as a rules error).
      allow delete: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
    }

    match /worldboss/{day}/hits/{id} {
      // Today in Vietnam by the server's clock, as yyyymmdd.
      function vnToday() {
        let t = request.time + duration.value(7, 'h');
        return t.year() * 10000 + t.month() * 100 + t.day();
      }

      allow read: if true;
      allow create, update: if request.auth != null
        && day.matches('[0-9]{8}')
        // No day still to come: a phone set ahead filed boards for 7 and 8
        // November on the 6th (1.8.3). Yesterday's is fine (a run that
        // ended just after midnight).
        && int(day) <= vnToday()
        && id in [request.auth.uid + '_0', request.auth.uid + '_1', request.auth.uid + '_2', request.auth.uid + '_3', request.auth.uid + '_4']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.hanh is int
        && request.resource.data.hanh >= 0 && request.resource.data.hanh <= 4
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 99
        && request.resource.data.rebirths is int
        && request.resource.data.rebirths >= 0 && request.resource.data.rebirths <= 6
        && request.resource.data.dmg is int
        // A day's damage: no more than worldBossDayCap (world_boss.dart),
        // 2 billion per (rebirths + 1). 1.8.2: an edited client posted 838
        // billion under the old 1e12 bound.
        && request.resource.data.dmg >= 0
        && request.resource.data.dmg <= 2000000000 * (request.resource.data.rebirths + 1)
        // Before the first rebirth: 2061 x level^3 (1.8.3).
        && (request.resource.data.rebirths > 0
            || request.resource.data.dmg <= 2061 * request.resource.data.level
                * request.resource.data.level * request.resource.data.level)
        // Potential points as on the main board (5 more a level in the
        // sixth life).
        && (!('pts' in request.resource.data)
            || (request.resource.data.pts is int
                && (request.resource.data.pts <= (request.resource.data.level - 1) * 5
                        + request.resource.data.rebirths * 40 + 190
                    || (request.resource.data.rebirths >= 6
                        && request.resource.data.pts <= (request.resource.data.level - 1) * 5
                            + request.resource.data.level * 5
                            + request.resource.data.rebirths * 40 + 190))))
        && !exists(/databases/$(database)/documents/lbBans/$(request.auth.uid));
      // A row that is not there is fine to delete (1.13.0: hiding deleted
      // every slot and day, and each missing one counted as a rules error).
      allow delete: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
    }

    // ------------------------------------------------ Bang hội (1.13.0)

    // The board rows ({uid}_{slot}) of the signed-in player.
    function myRows() {
      return [request.auth.uid + '_0', request.auth.uid + '_1', request.auth.uid + '_2', request.auth.uid + '_3', request.auth.uid + '_4'];
    }

    // Keeps bang names unique: guildNames/{name lowercased} = {gid, uid}.
    match /guildNames/{key} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['gid', 'uid'])
        && getAfter(/databases/$(database)/documents/guilds/$(request.resource.data.gid)).data.leader == request.auth.uid
        // The app's lowercase of the name; the rules' lower() is not used:
        // a name starting with Đ (« Đế Vương Tông ») was turned away by it,
        // while names whose only capitals were A-Z went through.
        && getAfter(/databases/$(database)/documents/guilds/$(request.resource.data.gid)).data.name.size() == key.size();
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/guilds/$(resource.data.gid)).data.leader == request.auth.uid);
    }

    match /guilds/{gid} {
      function guildAfter() {
        return getAfter(/databases/$(database)/documents/guilds/$(gid)).data;
      }
      function guildNow() {
        return get(/databases/$(database)/documents/guilds/$(gid)).data;
      }
      function isLeader() {
        return request.auth != null && guildNow().leader == request.auth.uid;
      }
      function isOfficer() {
        return request.auth != null
          && (guildNow().leader == request.auth.uid || request.auth.uid in guildNow().officers);
      }
      // A member row: who they are, their cống hiến and Boss Bang week
      // (damage no more than three Boss Thế Giới day caps).
      function goodMember(d) {
        return d.uid is string
          && d.name is string && d.name.size() > 0 && d.name.size() <= 24
          && d.hanh is int && d.hanh >= 0 && d.hanh <= 4
          && d.level is int && d.level >= 1 && d.level <= 99
          && d.rebirths is int && d.rebirths >= 0 && d.rebirths <= 6
          && d.power is int && d.power >= 0 && d.power <= 50000000
          && d.role is int && d.role >= 0 && d.role <= 2
          && d.contrib is int && d.contrib >= 0 && d.contrib <= 100000000
          && d.bw is int && d.bd is int && d.bd >= 0 && d.bd <= 6000000000 * (d.rebirths + 1)
          && d.keys().hasOnly(['uid', 'name', 'hanh', 'level', 'rebirths', 'power', 'role', 'contrib', 'bw', 'bd', 'at']);
      }

      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.leader == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 16
        && request.resource.data.notice is string && request.resource.data.notice.size() <= 120
        && request.resource.data.officers == []
        && request.resource.data.pts == 0
        && !exists(/databases/$(database)/documents/lbBans/$(request.auth.uid));
      allow update: if request.auth != null
        && request.resource.data.name == resource.data.name
        && request.resource.data.notice is string && request.resource.data.notice.size() <= 120
        && request.resource.data.pts is int && request.resource.data.pts >= 0 && request.resource.data.pts <= 4000000000
        && (
          // Bang chủ: settings, Phó bang, handing over.
          resource.data.leader == request.auth.uid
          // Phó bang: settings only.
          || (request.auth.uid in resource.data.officers
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notice', 'open', 'minLv']))
          // Any member: the sums shown in the list of bangs.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pts', 'n', 'by'])
              && request.resource.data.by in myRows()
              && get(/databases/$(database)/documents/guilds/$(gid)/members/$(request.resource.data.by)).data.uid == request.auth.uid)
        );
      allow delete: if request.auth != null && resource.data.leader == request.auth.uid;

      match /members/{row} {
        allow read: if true;
        allow create: if request.auth != null
          && goodMember(request.resource.data)
          && (
            // The Bang chủ's own row as the bang is made.
            (row in myRows() && request.resource.data.uid == request.auth.uid
                && request.resource.data.role == 2 && guildAfter().leader == request.auth.uid)
            // Joining a bang that takes anyone of its level.
            || (row in myRows() && request.resource.data.uid == request.auth.uid
                && request.resource.data.role == 0 && guildAfter().open == true
                && request.resource.data.level + request.resource.data.rebirths * 100 >= guildAfter().minLv)
            // Let in from an application by the Bang chủ or a Phó bang.
            || (request.resource.data.role == 0 && isOfficer()
                && exists(/databases/$(database)/documents/guilds/$(gid)/apps/$(row)))
          );
        allow update: if request.auth != null
          && goodMember(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && (
            // Their own row: numbers, not the role.
            (resource.data.uid == request.auth.uid && request.resource.data.role == resource.data.role)
            // The Bang chủ: roles only.
            || (isLeader() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
          );
        // Leaving, or put out: members by a Phó bang, anyone by the Bang chủ.
        allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid
              || (isOfficer() && (resource.data.role == 0 || isLeader())));
      }

      match /apps/{row} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && row in myRows()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 24;
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isOfficer());
      }

      // Kênh Bang: members write, as themselves.
      match /chat/{msg} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.row in myRows()
          && get(/databases/$(database)/documents/guilds/$(gid)/members/$(request.resource.data.row)).data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 120
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.keys().hasOnly(['row', 'uid', 'name', 'text', 'at'])
          && !exists(/databases/$(database)/documents/lbBans/$(request.auth.uid));
        allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isOfficer());
      }
    }

    // Hảo hữu (1.13.0): a friend's gift of the day, gifts/{toRow}/in/{fromRow}.
    match /gifts/{to}/in/{from} {
      allow read, delete: if request.auth != null && to in myRows();
      allow create, update: if request.auth != null
        && from in myRows()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'hanh', 'level', 'day', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.day is string && request.resource.data.day.size() == 8;
    }
  }
}
