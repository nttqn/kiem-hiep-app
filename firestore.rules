rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player reads and writes only their own save slots.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public leaderboard: anyone reads; a signed-in player writes only the
    // rows of their own three slots, with sane values.
    match /leaderboard/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && id in [request.auth.uid + '_0', request.auth.uid + '_1', request.auth.uid + '_2']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 40
        && request.resource.data.hanh is int
        && request.resource.data.hanh >= 0 && request.resource.data.hanh <= 4
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 99
        && request.resource.data.rebirths is int
        && request.resource.data.rebirths >= 0 && request.resource.data.rebirths <= 5
        && request.resource.data.rank == request.resource.data.rebirths * 100 + request.resource.data.level
        && request.resource.data.power is int
        && request.resource.data.power >= 0 && request.resource.data.power <= 50000000
        && request.resource.data.tower is int
        && request.resource.data.tower >= 0 && request.resource.data.tower <= 5000
        // Lôi đài season * 100000 + points (1.0.10+; older apps omit it).
        && (!('arenaS' in request.resource.data)
            || (request.resource.data.arenaS is int
                && request.resource.data.arenaS >= 0 && request.resource.data.arenaS <= 100000000));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Boss Thế Giới: one board per Vietnam day, same ownership rules.
    match /worldboss/{day}/hits/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && day.matches('[0-9]{8}')
        && id in [request.auth.uid + '_0', request.auth.uid + '_1', request.auth.uid + '_2']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.hanh is int
        && request.resource.data.hanh >= 0 && request.resource.data.hanh <= 4
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 99
        && request.resource.data.rebirths is int
        && request.resource.data.rebirths >= 0 && request.resource.data.rebirths <= 5
        && request.resource.data.dmg is int
        && request.resource.data.dmg >= 0 && request.resource.data.dmg <= 1000000000000;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
